## Climate processing ----------------------------------------------------------
# Global plots
MAT <- read.table("./Data/PALEO_PGEM-bioclim/bio1_mean.txt", header = T)
library(tidyverse)
View(MAT)
mean_MAT <- apply(X = MAT, FUN = mean, MARGIN = 2)
mean_MAT <- (mean_MAT - mean(mean_MAT))/sd(mean_MAT)
View(MAT)
mean_MAT <- apply(X = MAT[, 3:ncol(MAT)], FUN = mean, MARGIN = 2)
mean_MAT <- (mean_MAT - mean(mean_MAT))/sd(mean_MAT)
plot(X = seq(5000, 0, -1), mean_MAT)
plot(X = seq(5000, 0, -1), mean_MAT, type = 'l')
plot(X = 0:5000, mean_MAT, type = 'l')
plot(X = 5000:0, mean_MAT, type = 'l')
plot(X = 5000:0, y = ean_MAT, type = 'l')
plot(X = 5000:0, y = mean_MAT, type = 'l')
plot(x = 5000:0, y = mean_MAT, type = 'l')
rm(MAT)
df <- data.frame(t = 5000:0, MAT = mean_MAT)
df %>%
ggplot(aes(x = t, y = MAT)) +
geom(line) +
theme_minimal
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line() +
theme_minimal()
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3") +
theme_minimal()
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3", linewidth = 1) +
labs(x = "Time (ky BP)", y = "Temperature") +
theme(panel.grid = element_blank(),
plot.background = element_rect(fill = "transparent"))
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3", linewidth = 1) +
labs(x = "Time (ky BP)", y = "Temperature") +
theme(panel.grid = element_blank(),
panel.background = element_rect(fill = "transparent"))
df <- data.frame(t = seq(from = 5, to = 0, by = 0.01), MAT = mean_MAT)
df <- data.frame(t = seq(from = 5, to = 0, by = -0.01), MAT = mean_MAT)
df <- data.frame(t = seq(from = 5, to = 0, by = -1e-3), MAT = mean_MAT)
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3", linewidth = 1) +
labs(x = "Time (ky BP)", y = "Temperature") +
theme(panel.grid = element_blank(),
panel.background = element_rect(fill = "transparent"))
library(deeptime)
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3", linewidth = 1) +
labs(x = "Time (Ma)", y = "Temperature") +
theme(panel.grid = element_blank(),
panel.background = element_rect(fill = "transparent")) +
coord_geo(dat = "epochs", height = unit(1, "line"), center_end_labels = T, size = "auto")
mean_MAT <- mean_MAT[1000:length(mean_MAT)]
mean_MAT <- mean_MAT[2:length(mean_MAT)]
df <- data.frame(t = seq(from = 4, to = 0, by = -1e-3), MAT = mean_MAT)
df %>%
ggplot(aes(x = t, y = MAT)) +
geom_line(colour = "#4eb3d3", linewidth = 1) +
labs(x = "Time (Ma)", y = "Temperature") +
theme(panel.grid = element_blank(),
panel.background = element_rect(fill = "transparent")) +
coord_geo(dat = "epochs", height = unit(1, "line"), center_end_labels = T, size = "auto")
