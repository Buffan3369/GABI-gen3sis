## Temperature -----------------------------------------------------------------
clim_plot <- av_clim %>%
# Switch time to Myrs
mutate(time = time / 1000) %>%
ggplot(aes(x = time, y = clim_av)) +
annotate(geom = "rect", xmin = 3.45, xmax = 3.55, ymin = -Inf, ymax = Inf, alpha = 0.3, fill = "#810f7c") +
geom_line(lwd = 0.15) +
