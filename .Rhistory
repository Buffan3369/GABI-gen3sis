colnames(pts) <- c("lon", "lat")
# Convert to spatial point
pts_sf <- st_as_sf(pts, coords = c("lon", "lat"), crs = crs(SA_mask))
pts_sp <- as(pts_sf, "Spatial")  # convert to SpatialPoints for gdistance
?transition
