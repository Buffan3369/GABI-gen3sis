config_i <- gsub("params\\$S", params$S, config_i)
config_i <- gsub("params\\$omega_T", params$omega_T, config_i)
config_i <- gsub("params\\$omega_P", params$omega_P, config_i)
config_i <- gsub("params\\$sigma_e", params$sigma_e, config_i)
