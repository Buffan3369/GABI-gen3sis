# In case a species crossed successfully (i.e. already counted previously) but still hasn't speciated
if(ncol(pa_t) > 2){
# Isolate North America by matching extracted cells with their original values
pa_t_NA <- merge(pa_t, xy_NA, by = c("x", "y"))
# Have some species reached North America?
if(ncol(pa_t_NA) == 3){
colons <- ones(pa_t_NA[,3])
}
else{
colons <- apply(X = pa_t_NA[,3:ncol(pa_t_NA)], MARGIN = 2, FUN = ones)
}
if(length(which(colons)) > 0){cat(paste0("Colonisation at t = ", t, " ! \n"))}
n_col <- n_col + length(which(colons))
}
}
length(which(colons))
