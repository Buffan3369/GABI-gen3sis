# Function assessing the most frequent element of a vector
most_freq <- function(vect){
vect_unique <- unique(vect)
nb_of_occurrence <- sapply(X = vect_unique,
FUN = function(x){length(which(vect == x))})
max_idx <- which(vect == max(vect))
return(vect_unique[max_idx])
}
most_freq(a)
