## Assess rate of speciation and extinction within a time bin ------------------
rate_per_bin <- function(ps_bin, bin_size, what = c("sp", "ext")){ #bin_size has to be in number of iterations
if(what == "sp"){
n_spec <- sum(ps_bin$speciations)
return(n_spec/bin_size)
}
if(what == "ext"){
n_ext <- sum(ps_bin$extinctions)
return(n_ext/bin_size)
}
}
n_bins <- 5
bin_size <- nrow(ps)%/%n_bins
sp <- c()
ext <- c()
for(i in 0:(n_bins-1)){
idx <- i*bin_size+1:(i+1)*bin_size
tmp_ps <- ps[idx, ]
sp <- c(sp, rate_per_bin(tmp_ps, bin_size, what = "sp"))
ext <- c(ext, rate_per_bin(tmp_ps, bin_size, what = "ext"))
}
