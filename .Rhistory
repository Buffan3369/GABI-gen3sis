temp1_pan <- raster::extract(temp1, panama, cellnumbers = T, df = T)
panama <- shapehile("./Data/Shapefile_masks/Panama.shp")
panama <- shapefile("./Data/Shapefile_masks/Panama.shp")
temp1_pan <- raster::extract(temp1, panama, cellnumbers = T, df = T)
sa <- shapefile("./Data/Shapefile_masks/South_America_cut.shp")
temp1_pan <- raster::extract(raster(temp1), panama, cellnumbers = T, df = T)
temp1_pan <- raster::extract(rasterFromXYZ(temp1), panama, cellnumbers = T, df = T)
View(temp1_pan)
r1 <- rasterFromXYZ(temp1)
temp1_pan <- raster::extract(r1, panama, cellnumbers = T, df = T)
xy <- coordinates(r1)[temp1_pan$cell,]
xyz <- cbind(xy, temp1_pan$T_0) %>% as.data.frame()
View(xyz)
colnames(xyz) <- c("lon", "lat", "temp")
panama %>% ggplot() +
geom_tile(xyz, aes(x = lon, y = lat, fill = temp)) +
geom_sf()
panama %>% ggplot() +
geom_tile(xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf()
panama_sf <- st_as_sf(panama)
panama_sf %>% ggplot() +
geom_tile(xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf()
panama_sf %>% ggplot() +
geom_tile(xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf(alpha = .1)
panama_sf %>% ggplot() +
geom_tile(xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf(alpha = .1) +
theme_minimal()
temp1_pan <- raster::crop(r1, panama, cellnumbers = T, df = T)
xy <- coordinates(r1)[temp1_pan$cell,]
temp1_pan_xyz <- xyFromCell(temp1_pan)
temp1_pan_xyz <- xyFromCell(temp1_pan, cell = 1:ncell(temp1_pan))
temp1_pan_xy <- xyFromCell(temp1_pan, cell = 1:ncell(temp1_pan))
temp1_pan_xyz <- cbind(temp1_pan_xy, temp1_pan$T_0)
temp1_pan_xyz <- cbind(temp1_pan_xy, temp1_pan$T_0) %>% as.data.frame()
colnames(temp1_pan_xyz) <- c("lon", "lat", "temp")
panama_sf %>% ggplot() +
geom_tile(temp1_pan_xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf(alpha = .1) +
theme_minimal()
View(temp1_pan_xyz)
temp1_pan@data
temp1_pan_xyz <- cbind(temp1_pan_xy, temp1_pan@data@values) %>% as.data.frame()
colnames(temp1_pan_xyz) <- c("lon", "lat", "temp")
panama_sf %>% ggplot() +
geom_tile(temp1_pan_xyz, mapping = aes(x = lon, y = lat, fill = temp)) +
geom_sf(alpha = .1) +
theme_minimal()
saveRDS(temp1, "./Data/PALEO_PGEM-bioclim/bio1_xyz_present.RDS")
rm(list = ls())
dev.off()
