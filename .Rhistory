library(tidyverse)
library(raster)
Temp <- read.table("./Data/PALEO_PGEM-bioclim/bio1_mean.txt", header = T)
Temp_sub <- Temp %>% dplyr::select(Long, Lat, T_5000, T_3000, T_2580, T_1000, T_21, T_12, T_0)
rm(Temp)
# Precipitations
Prec <- read.table("./Data/PALEO_PGEM-bioclim/bio12_mean.txt", header = T)
Prec_sub <- Prec %>% dplyr::select(Long, Lat, T_5000, T_3000, T_2580, T_1000, T_21, T_12, T_0)
rm(Prec)
# Mask of the Americas
Americas <- shapefile("./Data/Shapefile_masks/raw_mask.shp")
View(Prec_sub)
i <- 5000
tmp_Temp <- Temp_sub[, c("Long", "Lat", paste0("T_", i))]
# Subset temperature estimates for the Americas
r_Temp <- rasterFromXYZ(tmp_Temp)
r_Temp_Am <- raster::extract(r_Temp, Americas, cellnumbers = TRUE, df = TRUE)
Americas_coord <- coordinates(r_Temp)[r_Temp_Am$cell,] %>% as.data.frame()
colnames(Americas_coord) <- c("Long", "Lat")
tmp_Temp_Am <- tmp_Temp %>%
group_by(Long) %>%
filter(Lat %in% Americas_coord$Lat & Long %in% Americas_coord$Long)
plot(rasterFromXYZ(r_Temp_Am))
raster::plot(rasterFromXYZ(r_Temp_Am))
plot(r_Temp)
r <- rasterFromXYZ(tmp_Temp_Am)
plot(r)
plot(Americas)
tmp_Temp_Am <- tmp_Temp %>%
#   group_by(Long) %>%
filter(Lat %in% Americas_coord$Lat & Long %in% Americas_coord$Long)
plot(rasterFromXYZ(tmp_Temp_Am))
tmp_Temp_Am <- tmp_Temp %>%
#   group_by(Long) %>%
filter(Lat %in% Americas_coord$Lat & Long %in% Americas_coord$Long)
plot(rasterFromXYZ(tmp_Temp_Am))
MAT_5M <- tmp_Temp
## Masks -----------------------------------------------------------------------
NthAm <- shapefile("./Data/Shapefile_masks/North_America_cut.shp")
# North American cell coordinates
r_MAT_5M <- rasterFromXYZ(MAT_5M)
plot(r_MAT_5M)
r_MAT_5M_North <- raster::extract(r_MAT_5M, NthAm, cellnumbers = TRUE, df = TRUE)
NA_coord <- coordinates(r_MAT_5M)[r_MAT_5M_North$cell,] %>% as.data.frame()
colnames(NA_coord) <- c("Long", "Lat")
MAT_North <- MAT %>%
group_by(Long) %>%
filter(Lat %in% NA_coord$Lat & Long %in% NA_coord$Long)
## Subset temperature values contained in Northern and Southern hemispheres ----
MAT <- read.table("./Data/PALEO_PGEM-bioclim/bio1_mean.txt", header = T)
MAT_North <- MAT %>%
group_by(Long) %>%
filter(Lat %in% NA_coord$Lat & Long %in% NA_coord$Long)
plot(rasterFromXYZ(MAT_North[, c(1:3)]))
# Subset temperature estimates for the Americas
tmp_Temp <- Temp_sub[, c("Long", "Lat", paste0("T_", i))]
r_Temp <- rasterFromXYZ(tmp_Temp)
r_Temp_Am <- raster::extract(r_Temp, Americas, cellnumbers = TRUE, df = TRUE)
xy_extracted <- coordinates(r_Temp)[r_Temp_Am$cell,] %>% as.data.frame()
xyz_extracted <- data.frame(cbind(xy_extracted, r_Temp_Am[,3]))
r_extracted <- rasterFromXYZ(xyz_extracted, crs = crs(Americas))
plot(r_extracted)
tmp_Prec <- Prec_sub[, c("Long", "Lat", paste0("T_", i))]
r_Prec <- rasterFromXYZ(tmp_Prec)
r_Prec_Am <- raster::extract(r_Prec, Americas, cellnumbers = TRUE, df = TRUE)
xy_extracted <- coordinates(r_Prec)[r_Prec_Am$cell,] %>% as.data.frame()
xyz_extracted <- data.frame(cbind(xy_extracted, r_Prec_Am[,3]))
r_extracted_Prec <- rasterFromXYZ(xyz_extracted, crs = crs(Americas))
par(mfrow = c(1,2))
plot(r_extracted)
plot(r_extracted_Prec)
# KG biomes
biomes <- readRDS("./Data/PALEO_PGEM-bioclim/KG_biomes/KG_biome_maps.RDS")
# Subset corresponding biome
corr_biome <- biomes[[i]]
plot(corr_biome)
rm(list = ls())
dev.off()
