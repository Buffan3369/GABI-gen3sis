"Neogene", "Miocene", "Burdigalian", 15.97, 20.44, "Newly entered", "Newly entered",
"Armella, Matías Alberto, Julieta Suriano, Esperanza Cerdeño, Daniel Alfredo García-López, Andres Echaurren, et Lucas Lothari. 2025. «The new earliest diverging Mesotheriinae (Mammalia, Notoungulata) from the Early Miocene (Burdigalian) of the Puna region, Catamarca, Argentina». Journal of Systematic Palaeontology 23 (1): 2456618.",
-67.73, -26.39, -63.10, -27.05, 18, "E", "herbivore")
View(NL)
spl[nrow(spl)+1,] <- matrix(new_line, ncol = 25)
as.tibble(NL)
spl[nrow(spl)+1,] <- tibble(NL)
tibble(NL)
tspl <- t(spl)
tspl[,ncol(tspl)+1] <- new
tspl[,ncol(tspl)+1] <- new_line
View(tspl)
tspl$new <- new_line
rm(tspl)
View(spl)
spl <- spl %>% add_row(order = "Notoungulata", family = "Mesotheriidae", genus = "Ichhutherium", accepted_name =  "Ichhutherium wayra",
status = "extinct", gen_lvl_status = "extinct", cc = "Argentina", state = "Puna de Catamarca", locality = NA,
formation = "Protero Grande", period = "Neogene", epoch = "Miocene", stage = "Burdigalian", lng = -67.73,
lat = -26.39, p_lng = -63.10, p_lat = -27.05, age = 18, diet = "herbivore", loc = "E",
primary_reference = "Armella, Matías Alberto, Julieta Suriano, Esperanza Cerdeño, Daniel Alfredo García-López, Andres Echaurren, et Lucas Lothari. 2025. «The new earliest diverging Mesotheriinae (Mammalia, Notoungulata) from the Early Miocene (Burdigalian) of the Puna region, Catamarca, Argentina». Journal of Systematic Palaeontology 23 (1): 2456618.") %>%
arrange(order, family, genus, accepted_name, primary_reference)
