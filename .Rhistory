library(tidyverse)
library(raster)
source("~/Documents/KoppenGeiger_inR/kgreclass_Rfunction.R")
## Function to get 12-month climate array at time t ----------------------------
get_clim <- function(t, what = c("temperture", "precipitation")){
tmp_array <- array(NA, dim = c(149, 360, 12))
for(i in 1:12){
month <- i
if(month < 10){
month <- paste0("0", month)
}
# Climate dataset
tmp <- read.table(paste0("./Data/PALEO_PGEM-bioclim/20379663/monthly_mean/monthly_", what , month, "M.txt"),
header = T)
# Get corresponding climate layer
tmp_t <- tmp[,c(1,2,(5000-t+2))]
colnames(tmp_t) <- c("Long", "Lat", "Clim")
tmp_t_wide <- tmp_t %>% pivot_wider(names_from = Long, values_from = Clim)
tmp_array[,,i] <- as.matrix(tmp_t_wide[,-c(1)])
return(tmp_array)
}
}
## Get biome at t -------------------------------------------------------------
get_biome_t <- function(t){
temp_array <- get_clim(t, what = "temperature")
temp_array <- get_clim(t, what = "precipitation")
biomes_at_t <- kg_reclass(Temp = temp_array,
Prec = prec_array,
type = "class")
}
