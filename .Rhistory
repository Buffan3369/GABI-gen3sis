alpha <- 0.05 # inflection param
p_ext_decay <- sapply(delta, FUN = function(x){1 / exp(-(x*(alpha - N_sp)))})
# decay fixed
delta1 <- 0.05
alpha1 <- seq(0.001, 1, 0.001)
p_ext_inflection <- sapply(alpha1, FUN = function(x){1 / exp(-(delta1*(x - N_sp)))})
# Plot
par(mfrow = c(1,2))
plot(delta, p_ext_decay, type = "l", main = "Prob extirpation as a function of decay")
plot(alpha1, p_ext_inflection, type = "l", main = "Prob extirpation as a function of inflection")
abline(v = N_sp, type = 2, col = )
