library(raster)
library(gdistance)
library(sf)
# open a mask to get CRS
SA_mask <- shapefile("./Data/Shapefile_masks/South_America_cut.shp")
cost_mat <- readRDS("./Results/M1_eq_area/South_America_start/config_M1_South_America_run_1/pa_matrices/pa_t_499.rds")
## Define the two points we'll assess the distance between ---------------------
# Sample one of the starting cells
spld <- sample(x = which(cost_mat[,3] == 1), size = 1)
start_xy <- cost_mat[spld, c(1,2)]
# Arbitrary point located near the Panamá isthmus
isthm_coord <- c(-84, 10)
# Merge
pts <- data.frame(rbind(start_xy, isthm_coord))
colnames(pts) <- c("lon", "lat")
# Convert to spatial point
pts_sf <- st_as_sf(pts, coords = c("lon", "lat"), crs = crs(SA_mask))
View(pts_sf)
View(pts_sf)
pts_sp <- as(pts_sf, "Spatial")  # convert to SpatialPoints for gdistance
View(pts_sp)
## Rasterise cost matrix and create a transition object out of it --------------
cost_rast <- rasterFromXYZ(cost_mat, crs = crs(SA_mask))
# Transition object, defining the cost of moving from one cell to the other
tr <- transition(cost_rast,
directions = 8,
transitionFunction = function(x){
return(1/mean(x))
}
)
# Correct for geographic distorsion (necessary to account for distorsion in the map + unequal distances of moving vert/hzl and in diagonal)
tr_corrected <- geoCorrection(tr, type = "c")
## Compute least-cost distance (i.e., minimal, as implies the least amount of steps) ---
# Compute least-cost distance between two points
cost_dist <- costDistance(tr_corrected, pts_sp[1], pts_sp[2])
pts_sp[1]
pts_sp
pts_sp[[1]]
pts_sp[,1]
pts_sp[1,]
# Merge
start_df <- data.frame(lon = start_xy[1], lat = start_xy[2])
# Merge
start_df <- data.frame(lon = start_xy[1], lat = start_xy[2])
start_sf <- st_as_sf(start_df, coords = c("lon", "lat"), crs = crs(SA_mask))
start_sp <- as(start_sf, "Spatial")
isthm_df <- data.frame(lon = isthm_coord[1], lat = isthm_coord[2])
isthm_sf <- st_as_sf(isthm_df, coords = c("lon", "lat"), crs = crs(SA_mask))
isthm_sp <- as(isthm_sf, "Spatial")
## Compute least-cost distance (i.e., minimal, as implies the least amount of steps) ---
# Compute least-cost distance between two points
