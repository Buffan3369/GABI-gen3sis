# Function assessing the most frequent element of a vector
most_freq <- function(vect, na.rm = T){
vect_unique <- unique(vect)
if(na.rm){
vect_unique <- vect_unique[!is.na(vect_unique)]
}
nb_of_occurrence <- sapply(X = vect_unique,
FUN = function(x){length(which(vect == x))})
max_idx <- which(nb_of_occurrence == max(nb_of_occurrence))
return(vect_unique[max_idx])
}
b <- c(a, NA, NA, NA, NA, NA, NA, NA)
most_freq(b, na.rm = F)
a
unique(b)
