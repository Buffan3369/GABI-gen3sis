param_df$omega_P <-    linMap(as.numeric(param_df$omega_T), from = 0.05, to = 0.3, rnd = T, dgts = 3)
param_df$sigma_e <-    linMap(as.numeric(param_df$sigma_e), from = 0.005, to = 0.1, rnd = T, dgts = 3)
param_df$disp_shape <- linMap(as.numeric(param_df$disp_shape), from = 0.5, to = 3, rnd = T, dgts = 3)
param_df$disp_scale <- linMap(as.numeric(param_df$disp_scale), from = 0.1, to = 2, rnd = T, dgts = 3)
param_df$decay <-      linMap(as.numeric(param_df$decay), from = -1.5, to = 1.5, rnd = T, dgts = 3)
param_df$inflexion <- linMap(as.numeric(param_df$inflexion), from = 500, to = 2000, rnd = T, dgts = 3) # OM of individual richness, can't go below
## Add fixed parameters --------------------------------------------------------
