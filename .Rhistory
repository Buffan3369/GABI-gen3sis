library(randtoolbox)
a2 <- sobol(n=100, dim = 2)
plot(a2[,1]*(0.076-0.01)+0.01,
a2[,2]*(0.126-0.05)+0.05)
a2 <- sobol(n=100, dim = 2)
omega <- data.frame(om_t = runif(n = 100, min = 0.01, max = 0.076),
om_p = runif(n = 100, min = 0.05, max = 0.125))
par(mfrow = c(1,2))
plot(x = omega[,1], y = omega[,2],
xlab = "temp", ylab = "prec", main = "Uniform")
plot(a2[,1]*(0.076-0.01)+0.01,
a2[,2]*(0.126-0.05)+0.05,
xlab = "temp", ylab = "prec", main = "Sobol")
