library(raster)
library(dplyr)
source("./R/useful/helper_functions.R")
## Retrieve the indices of the cells corresponding to North America ------------
pa_499 <- readRDS("./Results/M1_eq_area/South_America_start/config_M1_South_America_run_265/pa_matrices/pa_t_499.rds")
Nth_am_mask <- shapefile("./Data/Shapefile_masks/North_America_cut.shp")
all_cells <- rasterFromXYZ(pa_499, crs = crs(Nth_am_mask))
plot(Nth_am_mask)
Nth_Am_extr <- extract(Nth_am_mask, all_cells, cellnumbers = TRUE, df = TRUE)
Nth_Am_extr <- extract(all_cells, Nth_am_mask, cellnumbers = TRUE, df = TRUE)
Nth_Am_cells <- Nth_Am_extr$cell
pa_499_NA <- pa_499[Nth_Am_cells,]
max(Nth_Am_cells)
cellStats(all_cells)
global(all_cells, function(x) sum(x==1, na.rm=TRUE))
cellStats(all_cells, function(x) sum(x==1, na.rm=TRUE))
cellStats(all_cells, function(x) sum(x==1))
cellStats(all_cells, sum)
rm(list = ls())
