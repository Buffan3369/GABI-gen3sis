n_col <- 0
excluded_sp <- c()
dir <- "./Results/M1_eq_area/South_America_start/config_M1_South_America_run_1/pa_matrices/"
n_steps <- length(list.files(dir))
for(t in seq(499, (499-n_steps), -1)){
# Open Presence/Absence matrix
pa_t <- readRDS(paste0(dir, "pa_t_", t, ".rds"))
pa_t <- pa_t[, c(3:ncol(pa_t))] # remove coordinate columns
# Exclude species that already colonised successfully (a species cannot be counted more than once)
if(length(excluded_sp) > 0){pa_t <- pa_t[, -excluded_sp]}
# In case a species crossed successfully but still hasn't speciated
if(ncol(pa_t) > 0){
# Isolate North America
pa_t_NA <- pa_t[Nth_Am_cells, ]
# Have some species reached North America?
colons <- apply(X = pa_t_NA, MARGIN = 2, FUN = ones)
n_col <- n_col + length(which(colons))
excluded_sp <- c(excluded_sp, colnames(pa_t_NA)[colons])
}
}
