mutate(temp = temp/10) %>%
ggplot(aes(x = lon, y = lat, fill = temp)) +
scale_fill_scico(palette = "vik") +
geom_tile() +
facet_grid(.~resolution) +
labs(x = NULL, y = NULL, fill = "Temperature \n(°C)") +
theme(panel.background = element_rect(fill = "grey60",
colour = "black",
linewidth = 0.1),
panel.grid = element_blank(),
axis.line = element_blank(),
axis.ticks = element_blank(),
axis.text = element_blank(),
strip.background = element_rect(fill = "bisque2"),
legend.title = element_text(size = 8, hjust = 0.5),
legend.text = element_text(size = 6))
ggsave("./Figures/MS/Supp/Oscillayers/Downscaling_illustration.pdf", plot = merged_plt, height = 100,
width = 150, units = "mm")
ggsave("./Figures/MS/Supp/Oscillayers/Downscaling_illustration.png", plot = merged_plt,
dpi = 600, height = 100, width = 150, units = "mm")
ggsave("./Figures/MS/Supp/Oscillayers/Downscaling_illustration.png", plot = merged_plt,
dpi = 600, height = 80, width = 150, units = "mm")
dev.off()
xy_ref <- readRDS("../Data/Cell_Coordinates_Americas.RDS")
1/0.04
25*2.5
1/0.041
24*2.5
rm(list = ls())
