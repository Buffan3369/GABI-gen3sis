equation_Ar <- function(Lr, # Longueur de la rangée dentaire
Wr, # Largeur de la rangée dentaire
IC = c("None", "Lower", "Upper"), # Si on veut calculer l'intervalle de confiance
CF = 1.107){ # Facteur de correction
# On calcule Ar
Ar <- Lr * Wr
# On l'injecte dans l'équation basée sur l'Ar (Boivin et al. 2024 − Table 2)
if(IC == "None"){
m  <- 1.565 * log10(Ar) + 0.293 # estimé moyen
}
if(IC == "Lower"){
m <- (1.565 - 0.032) * log10(Ar) + (0.293 - 0.074) # Borne inférieure de l'IC
}
if(IC == "Upper"){
m <- (1.565 + 0.032) * log10(Ar) + (0.293 + 0.074) # Borne supérieure de l'IC
}
}
equation_Ar <- function(Lr, # Longueur de la rangée dentaire
Wr, # Largeur de la rangée dentaire
IC = c("None", "Lower", "Upper"), # Si on veut calculer l'intervalle de confiance
CF = 1.107){ # Facteur de correction
# On calcule Ar
Ar <- Lr * Wr
# On l'injecte dans l'équation basée sur l'Ar (Boivin et al. 2024 − Table 2)
if(IC == "None"){
log10_m  <- 1.565 * log10(Ar) + 0.293 # estimé moyen
}
if(IC == "Lower"){
log10_m <- (1.565 - 0.032) * log10(Ar) + (0.293 - 0.074) # Borne inférieure de l'IC
}
if(IC == "Upper"){
log10_m <- (1.565 + 0.032) * log10(Ar) + (0.293 + 0.074) # Borne supérieure de l'IC
}
# On convertit le log(body_mass) en masse et on corrige
m <- 10 ** log10_m
m_corr <- m * CF
# On retourne l'estimé corrigé
return(m_corr)
}
## Fonction pour calculer la BM (Boivin et al. 2024 − Table 2) -----------------
equation_Ar <- function(Lr, # Longueur de la rangée dentaire
Wr, # Largeur de la rangée dentaire
IC = c("None", "Lower", "Upper"), # Si on veut calculer l'intervalle de confiance
CF = 1.107){ # Facteur de correction
# On calcule Ar
Ar <- Lr * Wr
# Estimé moyen
if(IC == "None"){
log10_m  <- 1.565 * log10(Ar) + 0.293
}
# Borne inférieure de l'IC
if(IC == "Lower"){
log10_m <- (1.565 - 0.032) * log10(Ar) + (0.293 - 0.074)
}
# Borne supérieure de l'IC
if(IC == "Upper"){
log10_m <- (1.565 + 0.032) * log10(Ar) + (0.293 + 0.074)
}
# On convertit le log(body_mass) en masse et on corrige
m <- 10 ** log10_m
m_corr <- m * CF
# On retourne l'estimé corrigé
return(m_corr)
}
cat("La masse estimée de ton taxon est de ", equation_Ar(Lr = Lr, Wr = Wr, IC = "None"), " kg.")
## On applique cette équation au taxon Bolivien --------------------------------
Lr <- 64.66
Wr <- 12.62 # largeur linguo-labiale maximale de la rangée de dentaire inférieure (cf. Définition de Wr, page 8 de Boivin et al. 2024)
cat("La masse estimée de ton taxon est de ", equation_Ar(Lr = Lr, Wr = Wr, IC = "None"), " kg.")
## Fonction pour calculer la BM (Boivin et al. 2024 − Table 2) -----------------
equation_Ar <- function(Lr, # Longueur de la rangée dentaire
Wr, # Largeur de la rangée dentaire
IC = c("None", "Lower", "Upper"), # Si on veut calculer l'intervalle de confiance
CF = 1.107, # Facteur de correction
unit = "g"){
# On calcule Ar
Ar <- Lr * Wr
# Estimé moyen
if(IC == "None"){
log10_m  <- 1.565 * log10(Ar) + 0.293
}
# Borne inférieure de l'IC
if(IC == "Lower"){
log10_m <- (1.565 - 0.032) * log10(Ar) + (0.293 - 0.074)
}
# Borne supérieure de l'IC
if(IC == "Upper"){
log10_m <- (1.565 + 0.032) * log10(Ar) + (0.293 + 0.074)
}
# On convertit le log(body_mass) en masse et on corrige
m <- 10 ** log10_m
m_corr <- m * CF
# On retourne l'estimé corrigé converti en kg si nécessaire
if(unit == "kg"){
m_corr <- m_corr / 1000
}
return(m_corr)
}
cat("La masse estimée de ton taxon est de ", equation_Ar(Lr = Lr, Wr = Wr, IC = "None", unit = "kg"), " kg.")
cat("La masse estimée de ton taxon est de ", equation_Ar(Lr = Lr, Wr = Wr, IC = "None", unit = "kg"), " kg.\n")
cat("Elle est comprise entre ",
equation_Ar(Lr = Lr, Wr = Wr, IC = "Lower", unit = "kg"), " et ",
equation_Ar(Lr = Lr, Wr = Wr, IC = "Upper", unit = "kg"), " kg. ")
cat("La masse estimée de ton taxon est de ", equation_Ar(Lr = Lr, Wr = Wr, IC = "None", unit = "kg"), " kg.\n")
cat("Elle est comprise entre ",
equation_Ar(Lr = Lr, Wr = Wr, IC = "Lower", unit = "kg"), " et ",
equation_Ar(Lr = Lr, Wr = Wr, IC = "Upper", unit = "kg"), " kg. ")
