coordinates(North_America_raster)[try[,1],]
rm(list = ls())
library(raster)
library(h3jsr)
library(sf)
library(terra)
landscape <- readRDS("./Results/M0/North_America_start/config_M0_North_America_run_1/landscapes/landscape_t_4999.rds")
## Subset desired ancestral region ---------------------------------------------
North_America_coordinates <- landscape$coordinates[which(landscape$coordinates[,1] < -54 &
landscape$coordinates[,2] > 12.5),]
# Initial environment
North_America_environment <- landscape$environment[which(landscape$coordinates[,1] < -54 &
landscape$coordinates[,2] > 12.5), 1]
# Rasterise
North_America_raster <- rasterFromXYZ(cbind(North_America_coordinates, North_America_environment))
# Extend to reach the extent of the landscape
North_America_raster <- extend(North_America_raster, landscape$extent)
# Create a "bullshit" `terra` object with the same extent but uninformative layer
bullshit_env <- rep(1, length(North_America_environment))
North_America_terra <- rasterFromXYZ(cbind(North_America_coordinates, bullshit_env))
North_America_terra <- extend(North_America_terra, landscape$extent)
North_America_terra <- as(North_America_terra, "SpatRaster")
## Generate equal-area grid of similar resolution as our raster ----------------
cells <- h3jsr::get_res0()
cells <- get_children(h3_address = cells, res = 3) # res = 3 corresponds to cell area of ~12393km², close enough to 1x1° eq
# Unlist cell list
cells <- unlist(cells)
# Get centroids of cells
xy <- cell_to_point(cells, simple = FALSE)
# Extract coordinates
xy <- sf::st_coordinates(xy)
xy <- data.frame(xy)
# Update column names
colnames(xy) <- c("lng", "lat")
## Extract centroids contained in our desired ancestral area -------------------
# Convert raster to polygon
r_poly <- as.polygons(North_America_terra) |> st_as_sf(North_America_terra)
# Convert centroids to sf points
xy_sf <- st_as_sf(xy, coords = c("lng", "lat"), crs = st_crs(r_poly))
# Filter points inside the raster extent
xy_inside <- xy_sf[st_intersects(xy_sf, r_poly, sparse = FALSE), ]
# Convert back to dataframe
xy_filtered <- st_coordinates(xy_inside) |> as.data.frame()
colnames(xy_filtered) <- c("lng", "lat")
idx <- sample(x = 1:nrow(xy_filtered), size = 1)
try <- extract(North_America_raster, as.data.frame(xy_filtered[idx,]), cellnumbers = T)
try[,1]
North_America_raster <- raster::rasterFromXYZ(cbind(North_America_coordinates, North_America_environment))
# Extend initial raster to reach the extent of the landscape
North_America_raster <- extend(North_America_raster, landscape$extent)
#Set up ancestral species
North_America_start_cells  <- sample(Which(North_America_raster, cells=T), 1)
North_America_start_cells  <- as.character(North_America_start_cells)
North_America_start_cells
library(gen3sis)
rm(list = ls())
landscape <- readRDS("./Results/M0/North_America_start/config_M0_North_America_run_1/landscapes/landscape_t_4999.rds")
## Subset desired ancestral region ---------------------------------------------
North_America_coordinates <- landscape$coordinates[which(landscape$coordinates[,1] < -33 &
landscape$coordinates[,2] > 6),]
## Subset desired ancestral region ---------------------------------------------
South_America_coordinates <- landscape$coordinates[which(landscape$coordinates[,1] < -33 &
landscape$coordinates[,2] > 6),]
# Initial environment
South_America_environment <- landscape$environment[which(landscape$coordinates[,1] < -33 &
landscape$coordinates[,2] > 6), 1]
rm(North_America_coordinates)
# Rasterise
South_America_raster <- rasterFromXYZ(cbind(South_America_coordinates, South_America_environment))
# Extend to reach the extent of the landscape
South_America_raster <- extend(South_America_raster, landscape$extent)
# Create a "bullshit" `terra` object with the same extent but uninformative layer
bullshit_env <- rep(1, length(South_America_environment))
South_America_terra <- rasterFromXYZ(cbind(South_America_coordinates, bullshit_env))
South_America_terra <- extend(South_America_terra, landscape$extent)
South_America_terra <- as(South_America_terra, "SpatRaster")
plot(South_America_terra)
?do.call()
