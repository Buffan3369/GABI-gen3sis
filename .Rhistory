alpha1 <- seq(N_sp, 100, 1) # alpha can't be below N_sp (otherwise p_ext > 1)
p_ext_inflection <- sapply(alpha1, FUN = function(x){1 / (1 + exp(-(delta1*(x - N_sp)))) })
