facet_wrap(continent~var, scales = "free", labeller = labeller(continent = striplabs_cont,
var = striplabs_clim)) +
coord_geo(dat = "epochs", abbr = F, center_end_labels = T, height = unit(0.7, "line"), size = 2.5)
